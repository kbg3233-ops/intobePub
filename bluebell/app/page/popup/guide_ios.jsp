<%@ page contentType = "text/html; charset=UTF-8" %>
<!-- iOS 설치 안내 (앱 설치 안내 화면 data-tta="guideIos") : 하단 오버레이 + 단계 슬라이드 -->
<div class="pop-type-sheet guide" data-ttatg="guideIos">
	<div class="part-dim" data-tta="guideIos"></div>
	<div class="part-wrap">
		<div class="part-head">
			<h1 class="part-title">iOS 설치 안내</h1>
			<button type="button" class="part-close" data-tta="guideIos">닫기</button>
		</div>
		<div class="part-cont">
			<div class="swiper guide-swiper">
				<ol class="swiper-wrapper">
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">1</span><strong class="tit">설치하기 버튼 클릭</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_01.png" alt=""></div>
							<div class="desc">
								<p class="txt">설치 안내 페이지에서 [iPhone 설치하기] 버튼을 클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">2</span><strong class="tit">받기 버튼 클릭</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_02.png" alt=""></div>
							<div class="desc">
								<p class="txt">App Store의 Bluebell Edu 페이지에서 [받기]를<br>클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">3</span><strong class="tit">Face ID 인증</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_03.png" alt=""></div>
							<div class="desc">
								<p class="txt">Face ID(또는 비밀번호)로 인증합니다.</p>
								<p class="note">※ 측면 버튼을 두 번 누른 뒤 Face ID로 인증하면 설치가 시작됩니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">4</span><strong class="tit">앱 설치 진행</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_04.png" alt=""></div>
							<div class="desc">
								<p class="txt">홈 화면에 앱 설치가 진행됩니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">5</span><strong class="tit">설치 완료 확인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_05.png" alt=""></div>
							<div class="desc">
								<p class="txt">설치가 완료되면 홈 화면에서 Bluebell Edu 아이콘을 확인 · 실행합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">6</span><strong class="tit">로그인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_ios_06.png" alt=""></div>
							<div class="desc">
								<p class="txt">사내 계정으로 로그인하여 이용합니다.</p>
							</div>
						</div>
					</li>
				</ol>
			</div>
			<div class="dot-pagination"></div>
		</div>
		<div class="part-foot">
			<button type="button" class="btn-l-line" data-tta="guideIos">확인</button>
		</div>
	</div>
</div>
