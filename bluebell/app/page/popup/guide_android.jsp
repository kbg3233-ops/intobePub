<%@ page contentType = "text/html; charset=UTF-8" %>
<!-- Android 설치 안내 (앱 설치 안내 화면 data-tta="guideAndroid") : 하단 오버레이 + 단계 슬라이드 -->
<div class="pop-type-sheet guide" data-ttatg="guideAndroid">
	<div class="part-dim" data-tta="guideAndroid"></div>
	<div class="part-wrap">
		<div class="part-head">
			<h1 class="part-title">Android 설치 안내</h1>
			<button type="button" class="part-close" data-tta="guideAndroid">닫기</button>
		</div>
		<div class="part-cont">
			<div class="swiper guide-swiper">
				<ol class="swiper-wrapper">
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">1</span><strong class="tit">보안 위험 자동 차단 끄기</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_01.png" alt=""></div>
							<div class="desc">
								<p class="txt">[삼성 갤럭시] 설정<img src="../images/ico/ico_chevron_r.svg" alt=">">보안 및 개인정보 보호<img src="../images/ico/ico_chevron_r.svg" alt=">">‘보안 위험 자동 차단(Auto Blocker)’을 끕니다.</p>
								<p class="note">※ 사내 배포 앱 설치를 위해 필요합니다. 기기에 따라 ‘30분 일시중지’로 표시될 수 있습니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">2</span><strong class="tit">다운로드 버튼 클릭</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_02.png" alt=""></div>
							<div class="desc">
								<p class="txt">설치 안내 페이지에서 [Android 다운로드] 버튼을<br>클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">3</span><strong class="tit">파일 다운로드 확인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_03.png" alt=""></div>
							<div class="desc">
								<p class="txt">‘Bluebell.apk을(를) 다운로드하시겠습니까?’ 안내에서 [다운로드]를 클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">4</span><strong class="tit">다운로드 파일 열기</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_04.png" alt=""></div>
							<div class="desc">
								<p class="txt">다운로드가 완료되면 [열기]를 클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">5</span><strong class="tit">설정 버튼 클릭</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_05.png" alt=""></div>
							<div class="desc">
								<p class="txt">‘보안을 위해 차단됨’ 안내가 표시되면 [설정]을 클릭합니다.</p>
								<p class="note">※ 이 출처의 앱 설치 허용이 필요합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">6</span><strong class="tit">앱 설치 허용 켜기</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_06.png" alt=""></div>
							<div class="desc">
								<p class="txt">‘이 출처의 앱 설치 허용’을 켭니다.</p>
								<p class="note">※ 해당 브라우저에 한해 1회만 설정하면 됩니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">7</span><strong class="tit">설치 버튼 클릭</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_07.png" alt=""></div>
							<div class="desc">
								<p class="txt">뒤로 돌아가 ‘Bluebell Edu를 설치하시겠습니까?’ 에서 [설치]를 클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">8</span><strong class="tit">Play Protect 검사 확인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_08.png" alt=""></div>
							<div class="desc">
								<p class="txt">Play Protect 검사 안내가 표시되면 [설치]를 클릭합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">9</span><strong class="tit">설치 완료 확인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_09.png" alt=""></div>
							<div class="desc">
								<p class="txt">설치가 완료되면 홈 화면에서 Bluebell Edu 아이콘을 확인 · 실행합니다.</p>
							</div>
						</div>
					</li>
					<li class="swiper-slide">
						<p class="guide-step"><span class="num">10</span><strong class="tit">로그인</strong></p>
						<div class="guide-cont">
							<div class="illust"><img src="../images/img/guide/img_guide_android_10.png" alt=""></div>
							<div class="desc">
								<p class="txt">사내 계정으로 로그인하여 이용합니다.</p>
							</div>
						</div>
					</li>
				</ol>
			</div>
			<div class="dot-pagination"></div>
		</div>
		<div class="part-foot">
			<button type="button" class="btn-l-line" data-tta="guideAndroid">확인</button>
		</div>
	</div>
</div>
